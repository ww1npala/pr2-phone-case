<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.phonecase.ui.controller.LoginController"
      alignment="CENTER" spacing="15" styleClass="root-container">
    <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>

    <Label text="🛡 PhoneCase Manager" styleClass="app-title"/>
    <Label text="Модуль керування дизайнами чохлів" styleClass="app-subtitle"/>

    <VBox spacing="8" maxWidth="300" alignment="CENTER_LEFT">
        <Label text="Ім'я користувача:" styleClass="field-label"/>
        <TextField fx:id="usernameField" promptText="Введіть логін" maxWidth="300" styleClass="input-field"/>

        <Label text="Пароль:" styleClass="field-label"/>
        <PasswordField fx:id="passwordField" promptText="Введіть пароль" maxWidth="300" styleClass="input-field"/>

        <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" maxWidth="300"/>
        <ProgressIndicator fx:id="loadingIndicator" maxWidth="30" maxHeight="30"/>
    </VBox>

    <HBox spacing="10" alignment="CENTER">
        <Button fx:id="loginButton" text="Увійти" onAction="#handleLogin" styleClass="primary-button" defaultButton="true"/>
        <Button fx:id="registerButton" text="Реєстрація" onAction="#handleRegister" styleClass="secondary-button"/>
    </HBox>
</VBox>